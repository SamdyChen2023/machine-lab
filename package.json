{
  "name": "machine-lab",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "npm ci && npm run build",
    "test": "node --test",
    "lab": "node server/cli.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-progress": "^1.2.0",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-slider": "^1.6.0",
    "@radix-ui/react-switch": "^1.4.0",
    "@radix-ui/react-tabs": "^1.2.0",
    "@radix-ui/react-toggle-group": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Live system monitor and benchmark suite for testing sandboxes and VMs",
  "bin": {
    "machine-lab": "server/cli.mjs"
  }
}
